generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Provider {
  id           String       @id @default(cuid())
  name         String
  type         ProviderType
  description  String?
  status       Status       @default(ACTIVE)
  config       Json?        // Almacena token, apiKey, chatId, baseUrl, headers, sessionString, etc.
  lastTestedAt DateTime?
  lastTestOk   Boolean?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  requests LicenseRequest[]
  products ProviderProduct[]
}

model ProviderProduct {
  id         String   @id @default(cuid())
  providerId String
  name       String
  externalId String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  requests LicenseRequest[]
}

model Reseller {
  id          String   @id @default(cuid())
  name        String
  username    String   @unique
  email       String?  @unique
  discordId   String?
  telegramId  String?
  password    String
  status      Status   @default(ACTIVE)
  credits     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests    LicenseRequest[]
  movements   CreditMovement[]
}

model CreditMovement {
  id           String         @id @default(cuid())
  resellerId   String
  type         MovementType
  amount       Float
  balanceAfter Float
  note         String?
  requestId    String?
  createdAt    DateTime       @default(now())

  reseller     Reseller       @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  request      LicenseRequest? @relation(fields: [requestId], references: [id])
}

model LicenseRequest {
  id                 String        @id @default(cuid())
  resellerId         String
  providerId         String
  productId          String
  status             RequestStatus @default(PENDING)
  externalRequestId  String?
  licenseKey         String?
  responseData       Json?
  creditsUsed        Float         @default(0)
  errorMessage       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  reseller  Reseller        @relation(fields: [resellerId], references: [id])
  provider  Provider        @relation(fields: [providerId], references: [id])
  product   ProviderProduct @relation(fields: [productId], references: [id])

  logs      Log[]
  movements CreditMovement[]
}

model Log {
  id         String      @id @default(cuid())
  action     LogAction
  message    String
  metadata   Json?
  requestId  String?
  createdAt  DateTime    @default(now())

  request LicenseRequest? @relation(fields: [requestId], references: [id])
}

enum Role {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum ProviderType {
  TELEGRAM_BOT
  KEYAUTH
  REST_API
  CUSTOM
}

enum RequestStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum LogAction {
  LICENSE_CREATED
  LICENSE_DELETED
  HWID_RESET
  PROVIDER_CREATED
  PROVIDER_UPDATED
  PROVIDER_DELETED
  PROVIDER_ACTIVATED
  PROVIDER_DEACTIVATED
  PROVIDER_TEST
  PROVIDER_TEST_FAIL
  PROVIDER_ERROR
  PROVIDER_RESPONSE
  RESELLER_CREATED
  RESELLER_UPDATED
  RESELLER_DELETED
  RESELLER_CREDIT_ADDED
  RESELLER_CREDIT_DEDUCTED
  LICENSE_REQUEST_CREATED
  LICENSE_REQUEST_SUCCESS
  LICENSE_REQUEST_FAILED
  LICENSE_REFUND_CREATED
}

enum MovementType {
  LOAD
  DEDUCTION
  PURCHASE
  REFUND
}
