generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Provider {
  id           String       @id @default(cuid())
  name         String
  type         ProviderType
  description  String?
  status       Status       @default(ACTIVE)
  config       Json?        // Almacena token, apiKey, chatId, baseUrl, headers, sessionString, etc.
  lastTestedAt DateTime?
  lastTestOk   Boolean?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  requests LicenseRequest[]
  products ProviderProduct[]
}

model ProviderProduct {
  id         String   @id @default(cuid())
  providerId String
  name       String
  externalId String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Reseller {
  id          String   @id @default(cuid())
  name        String
  username    String   @unique
  email       String?  @unique
  discordId   String?
  telegramId  String?
  password    String
  status      Status   @default(ACTIVE)
  credits     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests    LicenseRequest[]
  movements   CreditMovement[]
}

model CreditMovement {
  id          String         @id @default(cuid())
  resellerId  String
  type        MovementType
  amount      Float
  balanceAfter Float
  note        String?
  createdAt   DateTime       @default(now())

  reseller    Reseller       @relation(fields: [resellerId], references: [id], onDelete: Cascade)
}

model LicenseRequest {
  id           String        @id @default(cuid())
  resellerId   String
  providerId   String
  product      String
  duration     String
  status       RequestStatus @default(PENDING)
  licenseKey   String?
  providerResp Json?
  createdAt    DateTime      @default(now())

  reseller Reseller @relation(fields: [resellerId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])

  logs Log[]
}

model Log {
  id         String      @id @default(cuid())
  action     LogAction
  message    String
  metadata   Json?
  requestId  String?
  createdAt  DateTime    @default(now())

  request LicenseRequest? @relation(fields: [requestId], references: [id])
}

enum Role {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum ProviderType {
  TELEGRAM_BOT
  KEYAUTH
  REST_API
  CUSTOM
}

enum RequestStatus {
  PENDING
  SUCCESS
  FAILED
}

enum LogAction {
  LICENSE_CREATED
  LICENSE_DELETED
  HWID_RESET
  PROVIDER_CREATED
  PROVIDER_UPDATED
  PROVIDER_DELETED
  PROVIDER_ACTIVATED
  PROVIDER_DEACTIVATED
  PROVIDER_TEST
  PROVIDER_TEST_FAIL
  PROVIDER_ERROR
  PROVIDER_RESPONSE
  RESELLER_CREATED
  RESELLER_UPDATED
  RESELLER_DELETED
  RESELLER_CREDIT_ADDED
  RESELLER_CREDIT_DEDUCTED
}

enum MovementType {
  LOAD
  DEDUCTION
  PURCHASE
  REFUND
}
